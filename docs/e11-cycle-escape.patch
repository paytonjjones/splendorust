+/// Experimental observation-only escape from repeated main and return positions.
+pub struct CycleEscapeAgent {
+    inner: SearchAgent,
+    rng: Rng,
+    recent_main: std::collections::VecDeque<Observation>,
+    recent_return: std::collections::VecDeque<Observation>,
+}
+impl CycleEscapeAgent {
+    pub fn new(seed: u64, config: SearchConfig) -> Self {
+        Self {
+            inner: SearchAgent::new(seed, config),
+            rng: Rng::new(seed ^ 0x6a09e667f3bcc909),
+            recent_main: std::collections::VecDeque::with_capacity(16),
+            recent_return: std::collections::VecDeque::with_capacity(16),
+        }
+    }
+}
+impl Agent for CycleEscapeAgent {
+    fn select_action(&mut self, o: &Observation, legal: &[Action]) -> Action {
+        let preferred = self.inner.select_action(o, legal);
+        let recent = match o.phase {
+            Phase::Main => &mut self.recent_main,
+            Phase::Return => &mut self.recent_return,
+            _ => return preferred,
+        };
+        let mut position = o.clone();
+        position.turns = 0;
+        let repeated = recent.contains(&position);
+        if recent.len() == 16 {
+            recent.pop_front();
+        }
+        recent.push_back(position);
+        if repeated && o.phase == Phase::Main && matches!(preferred, Action::Take(_)) {
+            let purchases: Vec<_> = legal
+                .iter()
+                .copied()
+                .filter(|a| matches!(a, Action::BuyVisible(_) | Action::BuyReserved(_)))
+                .collect();
+            if !purchases.is_empty() {
+                return best(o, &purchases, true);
+            }
+        }
+        if repeated && o.phase == Phase::Return && legal.len() > 1 {
+            let index = self.rng.index(legal.len() - 1);
+            return legal
+                .iter()
+                .copied()
+                .filter(|&a| a != preferred)
+                .nth(index)
+                .unwrap();
+        }
+        preferred
+    }
+}
+
