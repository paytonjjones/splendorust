+/// Experimental observation-only escape from repeated token-return positions.
+pub struct ReturnEscapeAgent {
+    inner: SearchAgent,
+    rng: Rng,
+    recent: std::collections::VecDeque<Observation>,
+}
+impl ReturnEscapeAgent {
+    pub fn new(seed: u64, config: SearchConfig) -> Self {
+        Self {
+            inner: SearchAgent::new(seed, config),
+            rng: Rng::new(seed ^ 0x6a09e667f3bcc909),
+            recent: std::collections::VecDeque::with_capacity(16),
+        }
+    }
+}
+impl Agent for ReturnEscapeAgent {
+    fn select_action(&mut self, o: &Observation, legal: &[Action]) -> Action {
+        let preferred = self.inner.select_action(o, legal);
+        if o.phase != Phase::Return {
+            return preferred;
+        }
+        let mut position = o.clone();
+        position.turns = 0;
+        let repeated = self.recent.contains(&position);
+        if self.recent.len() == 16 {
+            self.recent.pop_front();
+        }
+        self.recent.push_back(position);
+        if repeated && legal.len() > 1 {
+            let index = self.rng.index(legal.len() - 1);
+            return legal
+                .iter()
+                .copied()
+                .filter(|&a| a != preferred)
+                .nth(index)
+                .unwrap();
+        }
+        preferred
+    }
+}
+
 pub fn make_agent(name: &str, seed: u64, search: &SearchConfig) -> Result<Box<dyn Agent>, String> {
     Ok(match name {
         "random" => Box::new(RandomAgent::new(seed)),
         "greedy" | "simple-greedy" => Box::new(SimpleGreedyAgent),
         "strong" | "strong-heuristic" => Box::new(StrongHeuristicAgent),
         "search" | "mcts" => Box::new(SearchAgent::new(seed, search.clone())),
+        "search-return-escape" => Box::new(ReturnEscapeAgent::new(seed, search.clone())),
         _ => return Err(format!("unknown agent: {name}")),
     })
 }
