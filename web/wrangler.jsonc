{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "splendorust",
  "compatibility_date": "2026-10-02",
  "send_metrics": false,
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "GAME_LOGS",
      "database_name": "splendorust-game-logs",
      "database_id": "3cd328ce-a8bc-47d0-8075-e0115e5e255e",
      "migrations_dir": "migrations"
    }
  ]
}
