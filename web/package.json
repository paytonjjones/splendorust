{
  "name": "splendorust-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:webgpu && vite --host 127.0.0.1",
    "build:wasm": "bash scripts/build-wasm.sh",
    "sync:champion": "python3 scripts/sync-champion.py",
    "build": "npm run build:wasm && npm run sync:champion && npm run prepare:webgpu && vite build",
    "build:test": "npm run build:wasm && npm run sync:champion && npm run prepare:webgpu && vite build --mode test --outDir dist-test",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "preview:test": "vite preview --mode test --outDir dist-test --host 127.0.0.1 --port 4174 --strictPort",
    "test:e2e": "npm run build:test && playwright test",
    "test": "npm run test:e2e",
    "test:a11y": "npm run build:test && playwright test --grep @a11y",
    "test:perf": "npm run build:test && playwright test --grep @perf --workers=1",
    "deploy": "bash scripts/deploy-pages.sh",
    "test:logs": "node scripts/test-game-logs.mjs",
    "logs:export": "node scripts/export-games.mjs",
    "prepare:webgpu": "node scripts/prepare-webgpu.mjs",
    "test:gpu-mailbox": "node --experimental-strip-types scripts/test-gpu-mailbox.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@webgpu/types": "0.1.74",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}
